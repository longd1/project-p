[sub_resource type="GDScript" id="GDScript_kaaam"]
script/source = "extends AudioStreamPlayer2D

func _ready() -> void:
	if stream == null:
		push_error(\"Chưa gán file âm thanh vào Stream!\")
		return

	play()
	print(\"Đang thử phát âm thanh chém kiếm\")
"

